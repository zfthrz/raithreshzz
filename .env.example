# Local PC only, unless you intentionally expose an Ollama endpoint.
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=ingenierov3

# llama.cpp (OpenAI-compatible server) local backend.
# Start llama-server with the Qwen model and set these when different.
LLAMACPP_API_URL=http://localhost:8080/v1/chat/completions
LLAMACPP_MODEL=qwen3-14b
